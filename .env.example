# Setup: copy this file to .env in the project root, then fill in the values.
#   macOS / Linux:        cp .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
#   Windows (cmd):        copy .env.example .env
# Check it is ignored by git (should print ".env"): git check-ignore .env
#
# .env is git-ignored. Spring Boot reads it as a .properties file, so:
#   - use KEY=value, no "export", no spaces around "="
#   - do not quote values (quotes become part of the value)
# Real environment variables override the values in .env.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/phonebook
DB_USERNAME=
DB_PASSWORD=

# External city lookup service (full endpoint URL, without the ilKodu query parameter)
CITY_SERVICE_BASE_URL=

# Hazelcast client (optional; these are the defaults)
HAZELCAST_CLUSTER_NAME=dev
HAZELCAST_ADDRESS=127.0.0.1:5701
